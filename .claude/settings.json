{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run -p bite:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo info:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo audit:*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make deny)",
      "Bash(tools/remote-build.sh:*)",
      "Bash(actionlint:*)",
      "Bash(yamllint:*)",
      "Bash(shellcheck:*)"
    ],
    "deny": [
      "Read(private/**/capture/**)"
    ]
  }
}
