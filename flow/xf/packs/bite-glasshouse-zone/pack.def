# ZONE/Zone Status: Sent once a second while the controller is powered.
kind      zone_status
when      0:0:8 1
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.operating_mode glasshouse.door_open glasshouse.heating_active glasshouse.irrigation_active glasshouse.alarm_present glasshouse.spare_72 glasshouse.supply_voltage glasshouse.zone_label
field     glasshouse.message_id          0:0:8        uint optional
field     glasshouse.message_length      0:8:8        uint optional
field     glasshouse.zone_number         0:16:6       uint optional
field     glasshouse.sequence_number     0:22:10      uint optional
field     glasshouse.time_of_day         0:32:32      uint optional
field     glasshouse.operating_mode      0:64:4       uint via operating_mode optional
field     glasshouse.door_open           0:68:1       uint via door_open optional
field     glasshouse.heating_active      0:69:1       uint via heating_active optional
field     glasshouse.irrigation_active   0:70:1       uint via irrigation_active optional
field     glasshouse.alarm_present       0:71:1       uint via alarm_present optional
field     glasshouse.spare_72            0:72:8       uint optional
field     glasshouse.supply_voltage      0:80:16      uscale:1/100 optional
field     glasshouse.zone_label          0:96:32      ascii trim optional

# ZONE/Climate Report: Sent every five seconds with the zone's air and weather measurements.
kind      climate_report
when      0:0:8 2
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.air_temperature glasshouse.relative_humidity glasshouse.leaf_wetness glasshouse.outside_temperature glasshouse.spare_108 glasshouse.co2_concentration glasshouse.solar_irradiance glasshouse.wind_speed
field     glasshouse.message_id            0:0:8        uint optional
field     glasshouse.message_length        0:8:8        uint optional
field     glasshouse.zone_number           0:16:6       uint optional
field     glasshouse.sequence_number       0:22:10      uint optional
field     glasshouse.time_of_day           0:32:32      uint optional
field     glasshouse.air_temperature       0:64:16      sscale:1/100 optional
field     glasshouse.relative_humidity     0:80:10      uscale:1/10 optional
field     glasshouse.leaf_wetness          0:90:6       uint optional
field     glasshouse.outside_temperature   0:96:12      uscale:1/20:-102.4 optional
field     glasshouse.spare_108             0:108:4      uint optional
field     glasshouse.co2_concentration     0:112:16     uint optional
field     glasshouse.solar_irradiance      0:128:16     uscale:1/10 optional
field     glasshouse.wind_speed            0:144:16     uscale:1/100 optional

# ZONE/Irrigation Report: Sent once a second while an irrigation run is in progress, and once when it ends.
kind      irrigation_report
when      0:0:8 3
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.spare_64 glasshouse.valve_4_open glasshouse.valve_3_open glasshouse.valve_2_open glasshouse.valve_1_open glasshouse.pump_state glasshouse.spare_76 glasshouse.flow_rate glasshouse.volume_delivered glasshouse.nutrient_solution_ph glasshouse.electrical_conductivity
field     glasshouse.message_id                0:0:8        uint optional
field     glasshouse.message_length            0:8:8        uint optional
field     glasshouse.zone_number               0:16:6       uint optional
field     glasshouse.sequence_number           0:22:10      uint optional
field     glasshouse.time_of_day               0:32:32      uint optional
field     glasshouse.spare_64                  0:64:4       uint optional
field     glasshouse.valve_4_open              0:68:1       uint via valve_4_open optional
field     glasshouse.valve_3_open              0:69:1       uint via valve_3_open optional
field     glasshouse.valve_2_open              0:70:1       uint via valve_2_open optional
field     glasshouse.valve_1_open              0:71:1       uint via valve_1_open optional
field     glasshouse.pump_state                0:72:4       uint via pump_state optional
field     glasshouse.spare_76                  0:76:4       uint optional
field     glasshouse.flow_rate                 0:80:16      uscale:1/4 optional
field     glasshouse.volume_delivered          0:96:24      uscale:1/10 optional
field     glasshouse.nutrient_solution_ph      0:120:8      uscale:1/10 optional
field     glasshouse.electrical_conductivity   0:128:16     uscale:1/1000 optional

# ZONE/Vent Report: Sent every five seconds with the position of the roof vents.
kind      vent_report
when      0:0:8 4
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.roof_vent_offset_sign glasshouse.roof_vent_offset_magnitude glasshouse.spare_74 glasshouse.windward_vent_position glasshouse.leeward_vent_position glasshouse.vent_drive_state glasshouse.motor_current
field     glasshouse.message_id                   0:0:8        uint optional
field     glasshouse.message_length               0:8:8        uint optional
field     glasshouse.zone_number                  0:16:6       uint optional
field     glasshouse.sequence_number              0:22:10      uint optional
field     glasshouse.time_of_day                  0:32:32      uint optional
field     glasshouse.roof_vent_offset_sign        0:64:1       uint via roof_vent_offset_sign optional
field     glasshouse.roof_vent_offset_magnitude   0:65:9       uscale:1/10 optional
field     glasshouse.spare_74                     0:74:6       uint optional
field     glasshouse.windward_vent_position       0:80:8       uscale:1/2 optional
field     glasshouse.leeward_vent_position        0:88:8       uscale:1/2 optional
field     glasshouse.vent_drive_state             0:96:4       uint via vent_drive_state optional
field     glasshouse.motor_current                0:100:12     uint optional

# ZONE/Alarm: Sent when an alarm is raised, acknowledged or cleared.
kind      alarm
when      0:0:8 5
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.alarm_code glasshouse.severity glasshouse.acknowledged glasshouse.spare_75 glasshouse.occurrence_count glasshouse.minutes_since_raised glasshouse.spare_107
field     glasshouse.message_id             0:0:8        uint optional
field     glasshouse.message_length         0:8:8        uint optional
field     glasshouse.zone_number            0:16:6       uint optional
field     glasshouse.sequence_number        0:22:10      uint optional
field     glasshouse.time_of_day            0:32:32      uint optional
field     glasshouse.alarm_code             0:64:8       uint via alarm_code optional
field     glasshouse.severity               0:72:2       uint via severity optional
field     glasshouse.acknowledged           0:74:1       uint via acknowledged optional
field     glasshouse.spare_75               0:75:5       uint optional
field     glasshouse.occurrence_count       0:80:16      uint optional
field     glasshouse.minutes_since_raised   0:96:11      uint optional
field     glasshouse.spare_107              0:107:5      uint optional

# ZONE/Event Log: Sent on request with the most recent events of the zone.
kind      event_log
when      0:0:8 6
requires  glasshouse.message_id glasshouse.message_length glasshouse.zone_number glasshouse.sequence_number glasshouse.time_of_day glasshouse.record_count glasshouse.spare_72
field     glasshouse.message_id        0:0:8        uint optional
field     glasshouse.message_length    0:8:8        uint optional
field     glasshouse.zone_number       0:16:6       uint optional
field     glasshouse.sequence_number   0:22:10      uint optional
field     glasshouse.time_of_day       0:32:32      uint optional
field     glasshouse.record_count      0:64:8       uint optional
field     glasshouse.spare_72          0:72:8       uint optional

# ZONE/Maintenance Data
# named by message_type, no message file: identified, no field decoded
kind      maintenance_data
when      0:0:8 7

# an identifier the dictionary does not name: bite gives a record with no fields
kind      unidentified
field     glasshouse.zone_message_type_code 0:0:8 uint
