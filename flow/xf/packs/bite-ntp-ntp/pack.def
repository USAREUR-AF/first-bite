# NTP/symmetric active: A persistent symmetric active association sends symmetric active (mode 1) packets to a symmetric active peer association.
kind      symmetric_active
when      0:5:3 1
requires  ntp.leap_indicator ntp.version_number ntp.mode ntp.stratum ntp.poll ntp.precision ntp.root_delay ntp.root_dispersion ntp.reference_id ntp.reference_timestamp_seconds ntp.reference_timestamp_fraction ntp.origin_timestamp_seconds ntp.origin_timestamp_fraction ntp.receive_timestamp_seconds ntp.receive_timestamp_fraction ntp.transmit_timestamp_seconds ntp.transmit_timestamp_fraction
field     ntp.leap_indicator                 0:0:2        uint via leap_indicator optional
field     ntp.version_number                 0:2:3        uint optional
field     ntp.mode                           0:5:3        uint via mode optional
field     ntp.stratum                        0:8:8        uint via stratum optional
field     ntp.poll                           0:16:8       twos optional
field     ntp.precision                      0:24:8       twos optional
field     ntp.root_delay                     0:32:32      uscale:1/65536 optional
field     ntp.root_dispersion                0:64:32      uscale:1/65536 optional
field     ntp.reference_id                   0:96:32      uint optional
field     ntp.reference_timestamp_seconds    0:128:32     uint optional
field     ntp.reference_timestamp_fraction   0:160:32     uscale:1/4294967296 optional
field     ntp.origin_timestamp_seconds       0:192:32     uint optional
field     ntp.origin_timestamp_fraction      0:224:32     uscale:1/4294967296 optional
field     ntp.receive_timestamp_seconds      0:256:32     uint optional
field     ntp.receive_timestamp_fraction     0:288:32     uscale:1/4294967296 optional
field     ntp.transmit_timestamp_seconds     0:320:32     uint optional
field     ntp.transmit_timestamp_fraction    0:352:32     uscale:1/4294967296 optional

