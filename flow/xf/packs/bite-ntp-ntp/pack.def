# NTP/NTP control message
# named by message_type, no message file: identified, no field decoded
kind      ntp_control_message
when      0:5:3 6

# an identifier the dictionary does not name: bite gives a record with no fields
kind      unidentified
field     ntp.ntp_message_type_code 0:5:3 uint
