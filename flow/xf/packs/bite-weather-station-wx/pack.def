# WX/Heartbeat: Sent every ten seconds while the station is powered.
kind      heartbeat
when      0:0:8 1
requires  weather_station.heartbeat_message_type weather_station.message_length weather_station.station_id weather_station.uptime weather_station.battery_low weather_station.sensor_fault weather_station.mode weather_station.reserved
field     weather_station.heartbeat_message_type   0:0:8        uint via heartbeat_message_type optional
field     weather_station.message_length           0:8:16       uint optional
field     weather_station.station_id               0:24:32      ascii trim optional
field     weather_station.uptime                   0:56:32      uint optional
field     weather_station.battery_low              0:88:1       uint via battery_low optional
field     weather_station.sensor_fault             0:89:1       uint via sensor_fault optional
field     weather_station.mode                     0:90:2       uint via mode optional
field     weather_station.reserved                 0:92:4       uint optional

# WX/Observation: One set of readings.
kind      observation
when      0:0:8 2
requires  weather_station.observation_message_type weather_station.message_length weather_station.station_id weather_station.temperature weather_station.pressure weather_station.wind_direction weather_station.humidity weather_station.sample_serial weather_station.checksum
field     weather_station.observation_message_type   0:0:8        uint via observation_message_type optional
field     weather_station.message_length             0:8:16       uint optional
field     weather_station.station_id                 0:24:32      ascii trim optional
field     weather_station.temperature                0:56:16      sscale:1/100 optional
field     weather_station.pressure                   0:72:20      uint optional
field     weather_station.wind_direction             0:92:12      uscale:1/10 optional
field     weather_station.humidity                   0:104:32     f32 optional
field     weather_station.sample_serial              0:136:32     uint swap optional
field     weather_station.checksum                   0:168:16     uint optional

# WX/Position: Where the station is. Sent at power-on and whenever the station is moved.
kind      position
when      0:0:8 3
requires  uid lat lon hae weather_station.position_message_type weather_station.message_length weather_station.station_id weather_station.latitude weather_station.longitude weather_station.altitude
field     weather_station.position_message_type   0:0:8        uint via position_message_type optional
field     weather_station.message_length          0:8:16       uint optional
field     uid                                     0:24:32      ascii trim optional
field     weather_station.station_id              0:24:32      ascii trim optional
field     lat                                     0:56:64      f64 optional
field     weather_station.latitude                0:56:64      f64 optional
field     lon                                     0:120:64     f64 optional
field     weather_station.longitude               0:120:64     f64 optional
field     hae                                     0:184:32     f32 optional
field     weather_station.altitude                0:184:32     f32 optional

# an identifier the dictionary does not name: bite gives a record with no fields
kind      unidentified
field     weather_station.wx_message_type_code 0:0:8 uint
