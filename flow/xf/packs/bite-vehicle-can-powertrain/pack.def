# first-bite dictionary `vehicle-can`, interface POWERTRAIN.
# Message = 4 bytes of frame identifier (little-endian), then the payload.
# Payload bit offsets are the dictionary's start + 32. See pack.md.
# GENERATED by tools/bite2pack/bite2pack.py. Do not edit.
format        bite-vehicle-can-powertrain
version       1.0.0
distribution  public
source        "first-bite dictionary vehicle-can, version 1.0.0: dictionary.json (Apache License 2.0)"
source        "first-bite dictionary vehicle-can, version 1.0.0: POWERTRAIN/metadata.json (Apache License 2.0)"
source        "first-bite dictionary vehicle-can, version 1.0.0: POWERTRAIN/messages/Engine Status.json (Apache License 2.0)"
source        "first-bite dictionary vehicle-can, version 1.0.0: POWERTRAIN/messages/Wheel Speeds.json (Apache License 2.0)"
source        "the dictionary describes itself: Synthetic example: two frames on a vehicle CAN bus. Messages are identified by the CAN identifier, and signals are little-endian with bit 0 the least significant bit of byte 0."
uses          vehicle_can
wire          bits
bit_order     lsb
word_bytes    1

map       gear 0 Neutral
map       gear 1 First
map       gear 2 Second
map       gear 3 Third
map       gear 4 Fourth
map       gear 5 Fifth
map       gear 6 Sixth
map       gear 7 7
map       gear 8 8
map       gear 9 9
map       gear 10 10
map       gear 11 11
map       gear 12 12
map       gear 13 13
map       gear 14 14
map       gear 15 Reverse

map       check_engine 0 false
map       check_engine 1 true

# POWERTRAIN/Engine Status: Engine controller, 100 Hz.
kind      engine_status
when      0:0:11 256
requires  vehicle_can.engine_speed vehicle_can.coolant_temperature vehicle_can.throttle_position vehicle_can.gear vehicle_can.check_engine vehicle_can.engine_torque
field     vehicle_can.powertrain_frame_id   0:0:32       uint
field     vehicle_can.engine_speed          0:32:16      uscale:1/4 optional
field     vehicle_can.coolant_temperature   0:48:8       uscale:1:-40 optional
field     vehicle_can.throttle_position     0:56:10      uscale:1/10 optional
field     vehicle_can.gear                  0:66:4       uint via gear optional
field     vehicle_can.check_engine          0:70:1       uint via check_engine optional
field     vehicle_can.engine_torque         0:72:16      sscale:1/2 optional

# POWERTRAIN/Wheel Speeds: Brake controller, 50 Hz. Four 13-bit speeds packed end to end.
kind      wheel_speeds
when      0:0:11 257
requires  vehicle_can.front_left vehicle_can.front_right vehicle_can.rear_left vehicle_can.rear_right
field     vehicle_can.powertrain_frame_id 0:0:32       uint
field     vehicle_can.front_left    0:32:13      uscale:1/100 optional
field     vehicle_can.front_right   0:45:13      uscale:1/100 optional
field     vehicle_can.rear_left     0:58:13      uscale:1/100 optional
field     vehicle_can.rear_right    0:71:13      uscale:1/100 optional

# an identifier the dictionary does not name: bite gives a record with no fields
kind      unidentified
field     vehicle_can.powertrain_frame_id 0:0:32 uint
