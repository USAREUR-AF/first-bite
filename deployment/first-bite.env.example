# Environment of the first-bite service: /etc/first-bite/first-bite.env.
# systemd reads this file (EnvironmentFile=); restart the service after editing:
#   sudo systemctl restart first-bite
# A line starting with # is ignored. Every value below is a placeholder.

# Network interface to capture on. Required by the service.
FIRST_BITE_INTERFACE=eth0

# Extra arguments for mind, separated by spaces: --activate-subpubs,
# --no-promiscuous, --output. An argument that contains spaces (a --filter
# expression) cannot be given here; see docs/deployment.md.
FIRST_BITE_ARGS=

# Dictionary directory. Unset: packets are published undecoded.
#BITE_DICT_PATH=/etc/first-bite/dictionary

# ZeroMQ publishers. Unset: one PUB socket on tcp://127.0.0.1:12000.
PUBLISHER_CONFIG_PATH=/etc/first-bite/config/publishers.yml

# Sinks that forward records from the PUB socket. Unset: none.
#SUBSCRIBER_CONFIG_PATH=/etc/first-bite/config/subscribers.yml

# Credentials of the sinks. subscribers.yml holds no credential value: a key
# there is written as a reference, for example
#   cloud_access_key: "${FIRST_BITE_BLOB_ACCESS_KEY}"
# and the value is set here, in the one file that is readable by root and the
# service only (0640 root:firstbite). The names are yours to choose; these are
# the ones config/subscribers.example.yml uses. A variable that a reference
# names and that is not set here stops the service at startup, with an error
# naming the subscriber, the key and the variable. Write the value without
# quotes.
#FIRST_BITE_BLOB_ACCESS_KEY=
#FIRST_BITE_S3_ACCESS_KEY_ID=
#FIRST_BITE_S3_SECRET_ACCESS_KEY=

# Transforms; read only when FIRST_BITE_ARGS has --activate-subpubs.
#SUBPUB_CONFIG_PATH=/etc/first-bite/config/subpubs.yml

# Record version. Unset or 2: typed values. 1: every value as text.
#FIRST_BITE_RECORD_VERSION=2

# Copied into every record and every log line. Unset: null in the record.
# Name of the network the frames are captured from.
#DATA_SOURCE_NETWORK_NAME=example-net
# Where the capture point is.
#DATA_SOURCE_GEO_LOCATION=example-site
# Kind of system that produces the traffic.
#DATA_SOURCE_SYSTEM_TYPE=weather-station
# Who operates the capture point.
#DATA_SOURCE_OWNER=example-owner
# Handling label of the captured data, as your organisation writes it.
#DATA_PACKET_CLASSIFICATION=example-label
# Access-control marking of the captured data, if your organisation uses one.
#DATA_PACKET_ACCM=example-marking

# Log level; the per-record lines are logged by mind at info.
RUST_LOG=info

# Log lines without terminal colour codes, for the log file.
NO_COLOR=1
