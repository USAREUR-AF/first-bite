# Settings of the capture node; install.sh writes this file to
# /etc/first-bite-capture/capture.env. systemd reads it: KEY=value, no quotes
# needed, no shell expansion. It holds no credential.

# Network interface to capture on.
CAPTURE_INTERFACE=eth0
# Capture filter (pcap-filter syntax), for example: udp port 40100
# Empty captures every frame.
CAPTURE_FILTER=
# Bytes kept of each frame. 262144 keeps whole frames.
CAPTURE_SNAPLEN=262144

# A new file starts after this many kilobytes (1 kB = 1000 bytes) ...
CAPTURE_FILE_KB=100000
# ... or after this many seconds, whichever comes first.
CAPTURE_FILE_SECONDS=900
# Files kept. The oldest is deleted to make room, mirrored or not. Files from
# before a restart of the capture are kept too, up to this many, so the
# capture never uses more than 2 x CAPTURE_FILES x CAPTURE_FILE_KB of disk:
# 2 x 200 x 100 MB = 40 GB.
CAPTURE_FILES=200

# Where completed files are mirrored. Leave S3_ENDPOINT empty to keep files on
# this machine only; install.sh then leaves the mirror timer off.
# The access key is not set here: it is in /etc/first-bite-capture/s3-credentials.
S3_ENDPOINT=
S3_BUCKET=
# Objects are named <S3_PREFIX>/<file name>. Give each node its own prefix.
S3_PREFIX=capture
S3_REGION=us-east-1
