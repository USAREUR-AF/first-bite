# Settings of one first-bite tap: /etc/first-bite/tap-<name>.env.
# Restart after editing: sudo systemctl restart first-bite-tap@<name>
# Every value below is a placeholder.

# Network interface to capture on.
TAP_INTERFACE=eth0

# BPF filter: which frames go into the slices. Spaces are allowed.
TAP_FILTER=udp port 40100

# A slice is closed once it covers this many seconds.
TAP_SLICE_SECONDS=60

# Finished slices kept on disk under /var/lib/first-bite-tap/<name>/; older
# ones are deleted.
TAP_KEEP=60

# Extra arguments for mind, separated by spaces. To publish every finished
# slice to a Zenoh key through the REST port of the local island ({host} is
# the host name):
#   TAP_ARGS=--pcap-publish http://127.0.0.1:8000 --pcap-key sensor/pcap/{host}
# Also --pcap-slice-mb <MiB>, --pcap-publish-retries <N>, --no-promiscuous.
TAP_ARGS=
