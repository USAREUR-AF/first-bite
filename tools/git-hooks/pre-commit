#!/usr/bin/env bash
# Refuse a commit that adds material that does not belong in this repository:
# runs tools/check-public-tree.sh on the files staged for the commit.
#
# Install once per clone with `make hooks`
# (git config core.hooksPath tools/git-hooks).
#
# The check reads each staged file as it is in the working tree. Files under
# private/ and the two internal documents are never published and are not
# checked. Without a needle list (LEAK_NEEDLES or .leak-needles) the name
# check is skipped; the shape checks always run.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=()
while IFS= read -r -d '' file; do
  case "$file" in
    private/* | docs/plan.md | docs/decisions.md) ;;
    *) staged+=("$file") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

[ "${#staged[@]}" -gt 0 ] || exit 0

if ! tools/check-public-tree.sh "${staged[@]}"; then
  echo >&2
  echo "pre-commit: commit refused. Each line above is <class>: <file>:<line>." >&2
  echo "Replace the value with a documentation one (203.0.113.0/24, example.org)," >&2
  echo "or, for a value that identifies nothing real, end the line with" >&2
  echo "  opsec-allow: <reason>" >&2
  exit 1
fi
